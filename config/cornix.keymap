#include "zmk-helpers/helper.h"
#include "includes/cornix54.h"
#include "includes/arensito.h"
#include "includes/layers.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define HM_TAPPING_TERM 250
#define HM_TAPPING_TERM_FAST 200
#define HM_PRIOR_IDLE 70

// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
#define KEYS_T LH1 LH0 RH0 RH1
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define KANA_WAIT_MS 8
#define KANA_TAP_MS  8

#include "includes/combos.dtsi"
#include "includes/naginata_macros.dtsi"
#include "includes/naginata_combos.dtsi"
#include "includes/behaviors.dtsi"

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";

            // ------------------------------------------------------------------------------------------------------------
            // |       |  Q  |  L  | , / ?|  P   | @ / #|                   | | / &|  F    |  U    |  D   |   K   |       |
            // |   `   |  A  |  R  |  E   |  N   |  B   |                   |  G   |  S    |  I    |  T   |   O   |   '   |
            // | LCTRL |  Z  |  W  | . / !|  H   |  J   |        |  |       |  V   |  C    |  Y    |  M   |   X   | RCTRL |
            // | LALT  | GUI | TAB  | DEL  |SFT/SP|L1/RET|  |L1/RET|SFT/SP| BSPC | ESC  | MENU | RALT  |
            // ------------------------------------------------------------------------------------------------------------

            bindings = <
ARENSITO_ALPHA_ROWS
&kp LALT   &kp LGUI  &kp TAB     &mm_del_bspc     &mt LSHIFT SPACE  &lt LAYER_SYMBOLS RET  &lt LAYER_SYMBOLS RET  &mt RSHIFT SPACE  &mm_bspc_del    &kp ESC  &kp K_APP  &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        symbols_layer {
            display-name = "Symbols";

            // ------------------------------------------------------------------------------------------------------------
            // |TO_NAG |  {  |  }  |  [   |  ]   |  ^   |                   |  %   |  _    |  <    |  >   |   $   |IME_TG |
            // |  TAB  |  ;  |  /  |  -   |  0   |  :   |                   |  \   |  1    |  (    |  )   |   =   |       |
            // | LCTRL |  6  |  7  |  8   |  9   |  +   |        |  |       |  *   |  2    |  3    |  4   |   5   | RCTRL |
            // | LALT  | GUI | TAB  | DEL  |SPACE | (RET)|  | (RET)|SPACE | BSPC | ESC  | MENU | RALT  |
            // ------------------------------------------------------------------------------------------------------------

            bindings = <
&to_naginata  &kp LBRC  &kp RBRC  &kp LBKT   &kp RBKT  &kp CARET                  &kp PRCNT  &kp UNDER  &kp LT    &kp GT    &kp DLLR   &kp LA(GRAVE)
&kp TAB       &kp SEMI  &kp FSLH  &kp MINUS  &kp N0    &kp COLON                  &kp BSLH   &kp N1     &kp LPAR  &kp RPAR  &kp EQUAL  &none
&kp LCTRL     &kp N6    &kp N7    &kp N8     &kp N9    &kp PLUS   &kp C_MUTE &kp LG(L) &kp ASTRK  &kp N2     &kp N3    &kp N4    &kp N5     &kp RCTRL
&kp LALT      &kp LGUI  &kp TAB   &mm_del_bspc &kp SPACE &trans                   &trans     &kp SPACE  &mm_bspc_del &kp ESC &kp K_APP &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        neovim_layer {
            display-name = "Neovim";

            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |  b   |      |  e   |  w   |  H   |       |
            // |       |     |     |      |      |      |                   |  h   |  j   |  k   |  l   |  M   |       |
            // |       |     |     |      |      |      |        |  |       |  0   |      |      |  $   |  L   | (CTRL)|
            // |       |     |      |      |      |      |  | (RET)| (SP) |(BSPC)| (ESC)|(MENU)|(ALT) |
            // ------------------------------------------------------------------------------------------------------------

            bindings = <
&none   &none   &none   &none   &none   &none                   &kp B   &none   &kp E  &kp W      &kp LS(H)  &none
&none   &none   &none   &none   &none   &none                   &kp H   &kp J   &kp K  &kp L      &kp LS(M)  &none
&none   &none   &none   &none   &none   &none   &kp C_MUTE &kp LG(L)   &kp N0  &none   &none  &kp DLLR   &kp LS(L)  &trans
&none   &none   &none   &none   &none   &none                   &trans  &trans  &trans &trans     &trans     &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        naginata_layer {
            display-name = "Naginata";

            // ------------------------------------------------------------------------------------------------------------
            // |       |     |  き  |  て  |  し  |  <-  |                   |  ->  |  さ  |  る  |  す  |  へ  |       |
            // |       |  ろ |  け  |  と  |  か  |  っ  |                   |  く  |  あ  |  い  |  う  |  ー  |       |
            // |LM8/CTL|  ほ |  ひ  |  は  |  こ  |  そ  |        |  |       |  た  |  な  |  ん  |  ら  |  れ  |LM8/CTL|
            // |LM8/ALT|LM8/GUI| TAB| DEL  |L4/SP |L5/RET|  |L5/RET|L4/SP | BSPC | ESC  | MENU |LM8/ALT|
            // ------------------------------------------------------------------------------------------------------------

            bindings = <
&none                   &none                 &kana_ki  &kana_te  &kana_shi  &kp LEFT                   &kp RIGHT  &kana_sa  &kana_ru  &kana_su     &kana_he   &none
&none                   &kana_ro              &kana_ke  &kana_to  &kana_ka   &kana_ltsu                 &kana_ku   &kp A     &kp I     &kp U        &kp MINUS  &none
&lm LAYER_ARN_MOD LCTRL &kana_ho              &kana_hi  &kana_ha  &kana_ko   &kana_so   &kp C_MUTE &kp LG(L) &kana_ta   &kana_na  &kana_nn  &kana_ra     &kana_re   &lm LAYER_ARN_MOD RCTRL
&lm LAYER_ARN_MOD LALT  &lm LAYER_ARN_MOD LGUI &kp TAB  &mm_del_bspc &lt LAYER_NAGINATA_EXT SPACE &lt LAYER_NAGINATA_SYMBOLS RET  &lt LAYER_NAGINATA_SYMBOLS RET &lt LAYER_NAGINATA_EXT SPACE &mm_bspc_del &kp ESC &kp K_APP &lm LAYER_ARN_MOD RALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        naginata_ext_layer {
            display-name = "Naginata-Ext";

            // ------------------------------------------------------------------------------------------------------------
            // |       |     |  ね  |  り  |  め  | S+<- |                   | S+-> |  さ  |  よ  |  え  |  ゆ  |       |
            // |       |  せ |  み  |  に  |  ま  |  ち  |                   |  や  |  の  |  も  |  つ  |  ふ  |       |
            // | S+CTRL|  ほ |  ひ  |  を  |  、  |  ぬ  |        |  |       |  お  |  。  |  む  |  わ  |  れ  | S+CTRL|
            // | S+ALT |S+GUI|S+TAB | BSPC | S+SP |S+RET |  |S+RET | S+SP | DEL  | S+ESC|S+MENU| S+ALT |
            // ------------------------------------------------------------------------------------------------------------

            bindings = <
&none          &none         &kana_ne  &kana_ri  &kana_me   &kp LS(LEFT)               &kp LS(RIGHT)  &kana_sa  &kana_yo  &kp E      &kana_yu  &none
&none          &kana_se      &kana_mi  &kana_ni  &kana_ma   &kana_chi                  &kana_ya       &kana_no  &kana_mo  &kana_tsu  &kana_fu  &none
&kp LS(LCTRL)  &kana_ho      &kana_hi  &kana_wo  &kp COMMA  &kana_nu   &kp C_MUTE &kp LG(L) &kp O  &kp DOT   &kana_mu  &kana_wa   &kana_re  &kp LS(RCTRL)
&kp LS(LALT)   &kp LS(LGUI)  &kp LS(TAB) &mm_bspc_del &kp LS(SPACE)  &kp LS(RET)         &kp LS(RET)    &kp LS(SPACE)  &mm_del_bspc &kp LS(ESC) &kp LS(K_APP) &kp LS(RALT)
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        naginata_symbols_layer {
            display-name = "Naginata-Symbols";

            // ------------------------------------------------------------------------------------------------------------
            // |IME_TG |  (  |  )  |  {   |  }   |      |                   |      |  1    |  2    |  3   |  UP   |TO_ARN |
            // |  TAB  |  [  |  ]  |  ?   |  /   |  =   |                   |      |  4    |  5    |  6   |RECONV |       |
            // | LCTRL |  <  |  >  |  !   |  ~   |      |        |  |       |  0   |  7    |  8    |  9   | DOWN  | RCTRL |
            // | LALT  | GUI | TAB  | DEL  |SFT/SP| (RET)|  | (RET)|SFT/SP| BSPC | ESC  | MENU | RALT  |
            // ------------------------------------------------------------------------------------------------------------

            bindings = <
&kp LA(GRAVE)  &kp LPAR  &kp RPAR  &kp LBRC   &kp RBRC   &none                     &none   &kp N1  &kp N2  &kp N3  &kp UP        &to_arensito
&kp TAB        &kp LBKT  &kp RBKT  &kp QMARK  &kp FSLH   &kp EQUAL                 &none   &kp N4  &kp N5  &kp N6  &kp LG(FSLH)  &none
&kp LCTRL      &kp LT    &kp GT    &kp EXCL   &kp TILDE  &none      &kp C_MUTE &kp LG(L) &kp N0  &kp N7  &kp N8  &kp N9  &kp DOWN      &kp RCTRL
&kp LALT       &kp LGUI  &kp TAB   &mm_del_bspc &sp_shift_arrows LSHIFT SPACE &trans     &trans  &sp_shift_arrows RSHIFT SPACE &mm_bspc_del &kp ESC  &kp K_APP  &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        navigation_layer {
            display-name = "Navigation";

            // ------------------------------------------------------------------------------------------------------------
            // | TO_JA |  F1 |  F2 |  F3  |  F4  |  F5  |                   |PRTSCN| HOME |  UP  |  END |PG_UP |TO_EN |
            // | PAUSE |  F6 |  F7 |  F8  |  F9  |  F10 |                   | CAPS | LEFT | DOWN | RIGHT|PG_DN |  RET  |
            // | (CTRL)| F11 |     |LSHIFT|      |  F12 |        |  |       |SCRLCK|      |RSHIFT|      |INSERT| (CTRL)|
            // | (ALT) |(GUI)| TAB | (DEL)|SFT/SP| TO_SYS |  | TO_SYS |SFT/SP|(BSPC)| ESC  |(MENU)|(ALT) |
            // ------------------------------------------------------------------------------------------------------------

            bindings = <
&to LAYER_NAGINATA &kp F1 &kp F2  &kp F3     &kp F4  &kp F5                  &kp PRINTSCREEN  &kp HOME  &kp UP      &kp END    &kp PG_UP   &to LAYER_BASE
&kp PAUSE_BREAK  &kp F6   &kp F7  &kp F8     &kp F9  &kp F10                 &kp CAPSLOCK     &kp LEFT  &kp DOWN    &kp RIGHT  &kp PG_DN   &kp RET
&trans           &kp F11  &none   &kp LSHIFT &none   &kp F12  &none   &none  &kp SCROLLLOCK   &none     &kp RSHIFT  &none      &kp INSERT  &trans
&trans           &trans   &kp TAB &trans     &mt LSHIFT SPACE &to LAYER_SYSTEM &to LAYER_SYSTEM &mt RSHIFT SPACE &trans &kp ESC &trans &trans
            >;
            sensor-bindings = <&rot_scroll_horiz &rot_scroll_vert>;
        };

        system_layer {
            display-name = "System";

            // ------------------------------------------------------------------------------------------------------------
            // | TO_JA |     |     |      |      |      |                   |      |      |      |      |      | TO_EN |
            // |       |OUTUSB|OUTBLE|EP_ON|EP_OFF|BOOT(L)|                   |BOOT(R)| BT 1 | BT 2 | BT 3 |BTCLR |       |
            // |       |     |     |      |      |RST(L)|        |  |       |RST(R)|      |      |      |      |       |
            // |       |     |TO_EN|      |      |      |  |      |      |      |TO_JA |      |      |
            // ------------------------------------------------------------------------------------------------------------

            bindings = <
&to LAYER_NAGINATA &none &none &none &none &none &none &none &none &none &none &to LAYER_BASE
&none   &out OUT_USB  &out OUT_BLE  &ext_power EP_ON  &ext_power EP_OFF  &bootloader                   &bootloader  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR    &none
&none   &none         &none         &none             &none              &sys_reset    &kp C_MUTE &kp LG(L)   &sys_reset   &none         &none         &none         &none         &none
&none   &none         &to LAYER_BASE &none            &none              &none                         &none        &none         &none         &to LAYER_NAGINATA &none         &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        arn_mod_layer {
            display-name = "Arn-Mod";

            // ------------------------------------------------------------------------------------------------------------
            // |       |  Q  |  L  | , / ?|  P   | @ / #|                   | | / &|  F    |  U    |  D   |   K   |       |
            // |   `   |  A  |  R  |  E   |  N   |  B   |                   |  G   |  S    |  I    |  T   |   O   |   '   |
            // | LCTRL |  Z  |  W  | . / !|  H   |  J   |        |  |       |  V   |  C    |  Y    |  M   |   X   | RCTRL |
            // | (ALT) |(GUI)| TAB  | DEL  |SFT/SP|  RET |  |  RET |SFT/SP| BSPC | ESC  | MENU |(ALT)  |
            // ------------------------------------------------------------------------------------------------------------

            bindings = <
ARENSITO_ALPHA_ROWS
&trans     &trans    &kp TAB     &mm_del_bspc     &mt LSHIFT SPACE  &kp RET               &kp RET        &mt RSHIFT SPACE  &mm_bspc_del    &kp ESC  &kp K_APP  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };
    };
};
