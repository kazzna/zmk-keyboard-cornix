    /*
    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <3 2>;
            then-layer = <4>;
        };
    };
    */

    combos {
        compatible = "zmk,combos";

        // -------------------------------------------------------------
        // nvim レイヤー呼び出し: 「.」(27) + 「h」(28) (Layer 0)
        // -------------------------------------------------------------
        combo_navi {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&mo 6>;
            layers = <0>;
            slow-release;
        };

        // -------------------------------------------------------------
        // Fn & Nav レイヤー呼び出し (3キー同時ホールド):
        // 左手: 「w」(26) + 「.」(27) + 「h」(28) (Layer 0 & 2)
        // -------------------------------------------------------------
        combo_fn_nav_l {
            timeout-ms = <50>;
            key-positions = <26 27 28>;
            bindings = <&mo 5>;
            layers = <0 2>;
            slow-release;
        };

        // -------------------------------------------------------------
        // Fn & Nav レイヤー呼び出し (3キー同時ホールド):
        // 右手: 「c」(33) + 「y」(34) + 「m」(35) (Layer 0 & 2)
        // -------------------------------------------------------------
        combo_fn_nav_r {
            timeout-ms = <50>;
            key-positions = <33 34 35>;
            bindings = <&mo 5>;
            layers = <0 2>;
            slow-release;
        };

        // -------------------------------------------------------------
        // 濁音: 「か」(16) + 右手キー (Layer 2 & 3)
        // -------------------------------------------------------------
        combo_za {
            timeout-ms = <80>;
            key-positions = <16 7>;
            bindings = <&kana_za>;
            layers = <2 3>;
        };

        combo_zu {
            timeout-ms = <80>;
            key-positions = <16 9>;
            bindings = <&kana_zu>;
            layers = <2 3>;
        };

        combo_be {
            timeout-ms = <80>;
            key-positions = <16 10>;
            bindings = <&kana_be>;
            layers = <2 3>;
        };

        combo_gu {
            timeout-ms = <80>;
            key-positions = <16 18>;
            bindings = <&kana_gu>;
            layers = <2 3>;
        };

        combo_du {
            timeout-ms = <80>;
            key-positions = <16 21>;
            bindings = <&kana_du>;
            layers = <2 3>;
        };

        combo_bu {
            timeout-ms = <80>;
            key-positions = <16 22>;
            bindings = <&kana_bu>;
            layers = <2 3>;
        };

        combo_da {
            timeout-ms = <80>;
            key-positions = <16 32>;
            bindings = <&kana_da>;
            layers = <2 3>;
        };

        // -------------------------------------------------------------
        // 濁音: 「あ」(19) + 左手キー (Layer 2 & 3)
        // -------------------------------------------------------------
        combo_gi {
            timeout-ms = <80>;
            key-positions = <19 2>;
            bindings = <&kana_gi>;
            layers = <2 3>;
        };

        combo_de {
            timeout-ms = <80>;
            key-positions = <19 3>;
            bindings = <&kana_de>;
            layers = <2 3>;
        };

        combo_ji {
            timeout-ms = <80>;
            key-positions = <19 4>;
            bindings = <&kana_ji>;
            layers = <2 3>;
        };

        combo_ze {
            timeout-ms = <80>;
            key-positions = <19 13>;
            bindings = <&kana_ze>;
            layers = <2 3>;
        };

        combo_ge {
            timeout-ms = <80>;
            key-positions = <19 14>;
