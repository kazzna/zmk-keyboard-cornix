    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  Q  |  L  | , / ?|  P   | @ / #|                   | | / &|  F    |  U    |  D   |   K   |       |
            // |   `   |  A  |  R  |  E   |  N   |  B   |                   |  G   |  S    |  I    |  T   |   O   |   '   |
            // | LCTRL |  Z  |  W  | . / !|  H   |  J   |        |  |       |  V   |  C    |  Y    |  M   |   X   | RCTRL |
            // | LALT  | GUI |      | DEL  |SFT/SP|L1/RET|  |L1/RET|SFT/SP| BSPC |      | MENU | RALT  |
            // ------------------------------------------------------------------------------------------------------------

            bindings = <
&kp ESC    &kp Q     &kp L       &mm_comma_qmark  &kp P             &mm_at_hash                    &mm_pipe_amps  &kp F             &kp U         &kp D    &kp K      &none
&kp GRAVE  &kp A     &kp R       &kp E            &kp N             &kp B                          &kp G          &kp S             &kp I         &kp T    &kp O      &kp SQT
&kp LCTRL  &kp Z     &kp W       &mm_dot_excl     &kp H             &kp J      &kp C_MUTE &kp LG(L)   &kp V       &kp C             &kp Y         &kp M    &kp X      &kp RCTRL
&kp LALT   &kp LGUI  &none       &mm_del_bspc     &mt LSHIFT SPACE  &lt 1 RET             &lt 1 RET      &mt RSHIFT SPACE  &mm_bspc_del    &none    &kp K_APP  &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        Symbol_layer {
            display-name = "Symbols";

            // ------------------------------------------------------------------------------------------------------------
            // |TO_NAG |  {  |  }  |  [   |  ]   |  ^   |                   |  %   |  _    |  <    |  >   |   $   |IME_TG |
            // |  TAB  |  ;  |  /  |  -   |  0   |  :   |                   |  \   |  1    |  (    |  )   |   =   |       |
            // | LCTRL |  6  |  7  |  8   |  9   |  +   |        |  |       |  *   |  2    |  3    |  4   |   5   | RCTRL |
            // | LALT  | GUI |      | DEL  |SPACE | (RET)|  | (RET)|SPACE | BSPC |      | MENU | RALT  |
            // ------------------------------------------------------------------------------------------------------------

            bindings = <
&to_naginata  &kp LBRC  &kp RBRC  &kp LBKT   &kp RBKT  &kp CARET                  &kp PRCNT  &kp UNDER  &kp LT    &kp GT    &kp DLLR   &kp LA(GRAVE)
&kp TAB       &kp SEMI  &kp FSLH  &kp MINUS  &kp N0    &kp COLON                  &kp BSLH   &kp N1     &kp LPAR  &kp RPAR  &kp EQUAL  &none
&kp LCTRL     &kp N6    &kp N7    &kp N8     &kp N9    &kp PLUS   &kp C_MUTE &kp LG(L) &kp ASTRK  &kp N2     &kp N3    &kp N4    &kp N5     &kp RCTRL
&kp LALT      &kp LGUI  &none     &mm_del_bspc &kp SPACE &trans                   &trans     &kp SPACE  &mm_bspc_del &none  &kp K_APP  &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        Naginata_layer {
            display-name = "Naginata";

            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |     |  き  |  て  |  し  |  <-  |                   |  ->  |  さ  |  る  |  す  |  へ  |       |
            // |   `   |  ろ |  け  |  と  |  か  |  っ  |                   |  く  |  あ  |  い  |  う  |  ー  |       |
            // | LCTRL |  ほ |  ひ  |  は  |  こ  |  そ  |        |  |       |  た  |  な  |  ん  |  ら  |  れ  | RCTRL |
            // | LALT  | GUI |      | DEL  |L3/SP |L4/RET|  |L4/RET|L3/SP | BSPC |      | MENU | RALT  |
            // ------------------------------------------------------------------------------------------------------------

            bindings = <
&kp ESC    &none     &kana_ki  &kana_te  &kana_shi  &kp LEFT                   &kp RIGHT  &kana_sa  &kana_ru  &kana_su     &kana_he   &none
&kp GRAVE  &kana_ro  &kana_ke  &kana_to  &kana_ka   &kana_xtsu                 &kana_ku   &kp A     &kp I     &kp U        &kp MINUS  &none
&kp LCTRL  &kana_ho  &kana_hi  &kana_ha  &kana_ko   &kana_so   &kp C_MUTE &kp LG(L) &kana_ta   &kana_na  &kana_nn  &kana_ra     &kana_re   &kp RCTRL
&kp LALT   &kp LGUI  &none     &mm_del_bspc &lt 3 SPACE &lt 4 RET                  &lt 4 RET   &lt 3 SPACE &mm_bspc_del &none    &kp K_APP  &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        SandS_layer {
            display-name = "SandS";

            // ------------------------------------------------------------------------------------------------------------
            // | S+ESC |     |  ね  |  り  |  め  | S+<- |                   | S+-> |  さ  |  よ  |  え  |  ゆ  |       |
            // |   ~   |  せ |  み  |  に  |  ま  |  ち  |                   |  や  |  の  |  も  |  つ  |  ふ  |       |
            // | S+CTRL|  ほ |  ひ  |  を  |  、  |  ぬ  |        |  |       |  お  |  。  |  む  |  わ  |  れ  | S+CTRL|
            // | S+ALT |S+GUI|      | BSPC | (SP) |S+RET |  |S+RET | (SP) | DEL  |      |S+MENU| S+ALT |
            // ------------------------------------------------------------------------------------------------------------

            bindings = <
&kp LS(ESC)    &none         &kana_ne  &kana_ri  &kana_me   &kp LS(LEFT)               &kp LS(RIGHT)  &kana_sa  &kana_yo  &kp E      &kana_yu  &none
&kp LS(GRAVE)  &kana_se      &kana_mi  &kana_ni  &kana_ma   &kana_chi                  &kana_ya       &kana_no  &kana_mo  &kana_tsu  &kana_fu  &none
&kp LS(LCTRL)  &kana_ho      &kana_hi  &kana_wo  &kp COMMA  &kana_nu   &kp C_MUTE &kp LG(L) &kp O  &kp DOT   &kana_mu  &kana_wa   &kana_re  &kp LS(RCTRL)
&kp LS(LALT)   &kp LS(LGUI)  &none     &mm_bspc_del &trans  &kp LS(RET)                &kp LS(RET)    &trans    &mm_del_bspc &none    &kp LS(K_APP) &kp LS(RALT)
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        Symbol_ja_layer {
            display-name = "Symbols-Ja";

            // ------------------------------------------------------------------------------------------------------------
            // |IME_TG |  (  |  )  |  {   |  }   |      |                   |      |  1    |  2    |  3   |  UP   |TO_ARN |
            // |  TAB  |  [  |  ]  |  ?   |  /   |  =   |                   |      |  4    |  5    |  6   |RECONV |       |
            // | LCTRL |  <  |  >  |  !   |  ~   |      |        |  |       |  0   |  7    |  8    |  9   | DOWN  | RCTRL |
            // | LALT  | GUI |      | DEL  |SFT/SP| (RET)|  | (RET)|SFT/SP| BSPC |      | MENU | RALT  |
            // ------------------------------------------------------------------------------------------------------------

            bindings = <
&kp LA(GRAVE)  &kp LPAR  &kp RPAR  &kp LBRC   &kp RBRC   &none                     &none   &kp N1  &kp N2  &kp N3  &kp UP        &to_arensito
&kp TAB        &kp LBKT  &kp RBKT  &kp QMARK  &kp FSLH   &kp EQUAL                 &none   &kp N4  &kp N5  &kp N6  &kp LG(FSLH)  &none
&kp LCTRL      &kp LT    &kp GT    &kp EXCL   &kp TILDE  &none      &kp C_MUTE &kp LG(L) &kp N0  &kp N7  &kp N8  &kp N9  &kp DOWN      &kp RCTRL
&kp LALT       &kp LGUI  &none     &mm_del_bspc &sp_shift_arrows LSHIFT SPACE &trans     &trans  &sp_shift_arrows RSHIFT SPACE &mm_bspc_del &none    &kp K_APP  &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };


        Fn_Nav_layer {
            display-name = "Fn & Nav";

            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  F1 |  F2 |  F3  |  F4  |  F5  |                   |PRTSCN| HOME |  UP  |  END |PG_UP |       |
            // | PAUSE |  F6 |  F7 |  F8  |  F9  |  F10 |                   | CAPS | LEFT | DOWN | RIGHT|PG_DN |       |
            // | (CTRL)| F11 |     |      |      |  F12 |        |  |       |SCRLCK|      |      |      |INSERT| (CTRL)|
            // | (ALT) |(GUI)|TO_JA| (DEL)| (SP) | TO_SYS |  | TO_SYS | (SP) |(BSPC)|TO_EN |(MENU)|(ALT) |
            // ------------------------------------------------------------------------------------------------------------

            bindings = <
&kp ESC          &kp F1   &kp F2  &kp F3  &kp F4  &kp F5                  &kp PRINTSCREEN  &kp HOME  &kp UP    &kp END    &kp PG_UP   &none
&kp PAUSE_BREAK  &kp F6   &kp F7  &kp F8  &kp F9  &kp F10                 &kp CAPSLOCK     &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN   &none
&trans           &kp F11  &none   &none   &none   &kp F12  &none   &none  &kp SCROLLLOCK   &none     &none     &none      &kp INSERT  &trans
&trans           &trans   &to 2   &trans  &trans  &to 7                   &to 7            &trans    &trans    &to 0      &trans      &trans
            >;
            sensor-bindings = <&rot_scroll_horiz &rot_scroll_vert>;
        };

        Navi_layer {
            display-name = "nvim";

            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |     |     |      |      |      |                   |  b   |      |  e   |  w   |  H   |       |
            // |       |     |     |      |      |      |                   |  h   |  j   |  k   |  l   |  M   |       |
            // |       |     |     |      |      |      |        |  |       |  0   |      |      |  $   |  L   | (CTRL)|
            // | (ALT) |(GUI)|      |(DEL) | (SP) |(RET) |  | (RET)| (SP) |(BSPC)|      |(MENU)|(ALT) |
            // ------------------------------------------------------------------------------------------------------------

            bindings = <
&kp ESC &none   &none   &none   &none   &none                   &kp B   &none   &kp E  &kp W      &kp LS(H)  &none
&none   &none   &none   &none   &none   &none                   &kp H   &kp J   &kp K  &kp L      &kp LS(M)  &none
&none   &none   &none   &none   &none   &none   &kp C_MUTE &kp LG(L)   &kp N0  &none   &none  &kp DLLR   &kp LS(L)  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans &trans     &trans     &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        System_layer {
            display-name = "System";

            // ------------------------------------------------------------------------------------------------------------
            // | TO_EN |     |     |      |      |      |                   |      |      |      |      |      | TO_EN |
            // |       |BTCLR|OUTTOG|     |      |BOOT(L)|                   |BOOT(R)|     |      |      |      |       |
            // |       |     |     |      |      |RST(L)|        |  |       |RST(R)|      |      |      |      |       |
            // |       |     |TO_JA| BT 1 | BT 2 | BT 3 |  |      |      |      |TO_JA |      |      |
            // ------------------------------------------------------------------------------------------------------------

            bindings = <
&to 0   &none         &none         &none         &none         &none                         &none        &none  &none  &none  &none  &to 0
&none   &bt BT_CLR    &out OUT_TOG  &none         &none         &bootloader                   &bootloader  &none  &none  &none  &none  &none
&none   &none         &none         &none         &none         &sys_reset    &kp C_MUTE &kp LG(L)   &sys_reset   &none  &none  &none  &none  &none
&none   &none         &to 2         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2                  &none        &none  &none  &to 2  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        Debug_layer {
            display-name = "Debug";

            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | BTCLR | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &none        &none  &none   &none  &none  &none
&none       &none         &none         &none         &none         &none                         &none        &none  &none   &none  &none  &none
&none       &none         &none         &none         &none         &bootloader   &trans  &trans  &bootloader  &none  &none   &none  &none  &none
&none       &none         &none         &none         &none         &none                         &none        &none  &kp N7  &none  &none  &none
            >;
        };
    };
};
