#pragma once

/ {
    combos {
        compatible = "zmk,combos";

        // -------------------------------------------------------------
        // nvim レイヤー呼び出し: 「e」(15) + 「n」(16) (Layer 0)
        // -------------------------------------------------------------
        combo_navi {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&mo 2>;
            layers = <0>;
            slow-release;
        };

        // -------------------------------------------------------------
        // Fn & Nav レイヤー呼び出し (3キー同時ホールド):
        // 左手: 「w」(26) + 「.」(27) + 「h」(28) (Layer 0 & 3)
        // -------------------------------------------------------------
        combo_fn_nav_l {
            timeout-ms = <50>;
            key-positions = <26 27 28>;
            bindings = <&mo 6>;
            layers = <0 3>;
            slow-release;
        };

        // -------------------------------------------------------------
