        // 外来音: 「か」(16) + 「く」(18) + 母音 (グァ・グィ・グェ・グォ・グヮ)
        // -------------------------------------------------------------
        combo_gwa { // グァ
            timeout-ms = <80>;
            key-positions = <16 18 19>;
            bindings = <&kana_gwa>;
            layers = <3 4>;
        };

        combo_gwi { // グィ
            timeout-ms = <80>;
            key-positions = <16 18 20>;
            bindings = <&kana_gwi>;
            layers = <3 4>;
        };

        combo_gwe { // グェ
            timeout-ms = <80>;
            key-positions = <16 18 9>;
            bindings = <&kana_gwe>;
            layers = <3 4>;
        };

        combo_gwo { // グォ
            timeout-ms = <80>;
            key-positions = <16 18 32>;
            bindings = <&kana_gwo>;
            layers = <3 4>;
        };

        combo_gxwa { // グヮ
            timeout-ms = <80>;
            key-positions = <16 18 35>;
            bindings = <&kana_gxwa>;
            layers = <3 4>;
        };
    };
};
